diff --git a/launcher/app/src/main/java/com/gathin/tvhome/PrayerTimes.java b/launcher/app/src/main/java/com/gathin/tvhome/PrayerTimes.java
new file mode 100644
index 0000000..7c55737
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/PrayerTimes.java
@@ -0,0 +1,142 @@
+package com.gathin.tvhome;
+
+import java.util.Calendar;
+import java.util.TimeZone;
+
+/**
+ * Jadwal sholat dihitung di TV, tanpa internet, dengan kriteria Kemenag RI:
+ * Subuh 20°, Isya 18°, Ashar Syafi'i (bayangan 1×), Maghrib saat matahari terbenam,
+ * lalu ihtiyat (pengaman) beberapa menit, dibulatkan ke atas ke menit penuh.
+ * Rumus astronomi mengikuti PrayTimes.org (Hamid Zarrabi-Zadeh, LGPL/MIT-style).
+ */
+final class PrayerTimes {
+
+    static final String[] NAMES = {"Subuh", "Dzuhur", "Ashar", "Maghrib", "Isya"};
+    /** Lama "sekarang waktu X" tetap ditampilkan setelah waktunya masuk. */
+    static final int NOW_WINDOW_MIN = 15;
+
+    private PrayerTimes() {
+    }
+
+    /** Menit sejak tengah malam (waktu lokal) untuk lima waktu sholat pada tanggal {@code day}. */
+    static int[] forDay(Calendar day, double lat, double lng, int ihtiyatMin) {
+        TimeZone tz = day.getTimeZone();
+        Calendar noon = (Calendar) day.clone();
+        noon.set(Calendar.HOUR_OF_DAY, 12);
+        noon.set(Calendar.MINUTE, 0);
+        double tzHours = tz.getOffset(noon.getTimeInMillis()) / 3_600_000.0;
+        double jd = julian(day.get(Calendar.YEAR), day.get(Calendar.MONTH) + 1, day.get(Calendar.DAY_OF_MONTH))
+                - lng / (15.0 * 24.0);
+
+        // Dua putaran: putaran kedua memakai hasil pertama sebagai perkiraan, lebih tepat.
+        double[] t = {5, 12, 13, 18, 18};
+        for (int pass = 0; pass < 2; pass++) {
+            double[] p = new double[5];
+            for (int i = 0; i < 5; i++) p[i] = t[i] / 24.0;
+            t = new double[]{
+                    sunAngleTime(jd, 20.0, p[0], lat, true),
+                    midDay(jd, p[1]),
+                    asrTime(jd, 1, p[2], lat),
+                    sunAngleTime(jd, 0.833, p[3], lat, false),
+                    sunAngleTime(jd, 18.0, p[4], lat, false)};
+        }
+        int[] out = new int[5];
+        for (int i = 0; i < 5; i++) {
+            double h = t[i] + tzHours - lng / 15.0;
+            out[i] = (int) Math.ceil(h * 60.0 - 1e-6) + ihtiyatMin;
+        }
+        return out;
+    }
+
+    /** "04:12" */
+    static String hhmm(int minutes) {
+        minutes = ((minutes % 1440) + 1440) % 1440;
+        return String.format(java.util.Locale.ROOT, "%02d:%02d", minutes / 60, minutes % 60);
+    }
+
+    /**
+     * Baris untuk bar atas: "Ashar 15:02 · 1 j 12 m lagi", atau "Waktu Ashar · 15:02" selama
+     * {@link #NOW_WINDOW_MIN} menit setelah waktunya masuk.
+     */
+    static String nextLine(Calendar now, double lat, double lng, int ihtiyatMin) {
+        int[] today = forDay(now, lat, lng, ihtiyatMin);
+        int cur = now.get(Calendar.HOUR_OF_DAY) * 60 + now.get(Calendar.MINUTE);
+        for (int i = 0; i < 5; i++) {
+            if (cur >= today[i] && cur < today[i] + NOW_WINDOW_MIN) {
+                return "Waktu " + NAMES[i] + " · " + hhmm(today[i]);
+            }
+        }
+        for (int i = 0; i < 5; i++) {
+            if (today[i] > cur) return NAMES[i] + " " + hhmm(today[i]) + " · " + until(today[i] - cur);
+        }
+        Calendar tomorrow = (Calendar) now.clone();
+        tomorrow.add(Calendar.DAY_OF_MONTH, 1);
+        int subuh = forDay(tomorrow, lat, lng, ihtiyatMin)[0];
+        return NAMES[0] + " " + hhmm(subuh) + " · " + until(subuh + 1440 - cur);
+    }
+
+    /** Indeks waktu sholat berikutnya hari ini, atau -1 bila semua sudah lewat. */
+    static int nextIndex(int[] today, int curMin) {
+        for (int i = 0; i < 5; i++) if (today[i] > curMin) return i;
+        return -1;
+    }
+
+    private static String until(int minutes) {
+        int h = minutes / 60, m = minutes % 60;
+        if (h == 0) return m + " menit lagi";
+        return m == 0 ? h + " jam lagi" : h + " j " + m + " m lagi";
+    }
+
+    // --- astronomi -------------------------------------------------------------------------
+
+    private static double julian(int y, int m, int d) {
+        if (m <= 2) {
+            y -= 1;
+            m += 12;
+        }
+        double a = Math.floor(y / 100.0);
+        double b = 2 - a + Math.floor(a / 4.0);
+        return Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + d + b - 1524.5;
+    }
+
+    /** {declination in degrees, equation of time in hours} */
+    private static double[] sunPosition(double jd) {
+        double d = jd - 2451545.0;
+        double g = fixAngle(357.529 + 0.98560028 * d);
+        double q = fixAngle(280.459 + 0.98564736 * d);
+        double l = fixAngle(q + 1.915 * dsin(g) + 0.020 * dsin(2 * g));
+        double e = 23.439 - 0.00000036 * d;
+        double ra = darctan2(dcos(e) * dsin(l), dcos(l)) / 15.0;
+        double eqt = q / 15.0 - fixHour(ra);
+        double decl = darcsin(dsin(e) * dsin(l));
+        return new double[]{decl, eqt};
+    }
+
+    private static double midDay(double jd, double t) {
+        double eqt = sunPosition(jd + t)[1];
+        return fixHour(12 - eqt);
+    }
+
+    private static double sunAngleTime(double jd, double angle, double t, double lat, boolean beforeNoon) {
+        double decl = sunPosition(jd + t)[0];
+        double noon = midDay(jd, t);
+        double x = (-dsin(angle) - dsin(decl) * dsin(lat)) / (dcos(decl) * dcos(lat));
+        x = Math.max(-1, Math.min(1, x));
+        double span = darccos(x) / 15.0;
+        return noon + (beforeNoon ? -span : span);
+    }
+
+    private static double asrTime(double jd, int factor, double t, double lat) {
+        double decl = sunPosition(jd + t)[0];
+        double angle = -Math.toDegrees(Math.atan(1.0 / (factor + Math.tan(Math.toRadians(Math.abs(lat - decl))))));
+        return sunAngleTime(jd, angle, t, lat, false);
+    }
+
+    private static double dsin(double d) { return Math.sin(Math.toRadians(d)); }
+    private static double dcos(double d) { return Math.cos(Math.toRadians(d)); }
+    private static double darcsin(double x) { return Math.toDegrees(Math.asin(x)); }
+    private static double darccos(double x) { return Math.toDegrees(Math.acos(x)); }
+    private static double darctan2(double y, double x) { return Math.toDegrees(Math.atan2(y, x)); }
+    private static double fixAngle(double a) { a = a - 360.0 * Math.floor(a / 360.0); return a < 0 ? a + 360 : a; }
+    private static double fixHour(double h) { h = h - 24.0 * Math.floor(h / 24.0); return h < 0 ? h + 24 : h; }
+}
